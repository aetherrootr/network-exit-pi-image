[Unit]
Description=Network exit Cloudflare Tunnel
Wants=network-online.target
Requires=network-exit-network.service
After=network-online.target network-exit-network.service
ConditionPathExists=/etc/network-exit/cloudflare-token
StartLimitIntervalSec=0

[Service]
DynamicUser=yes
LoadCredential=token:/etc/network-exit/cloudflare-token
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file %d/token
Restart=on-failure
RestartSec=10s
TimeoutStartSec=90s
TimeoutStopSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
