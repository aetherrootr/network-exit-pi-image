{
  "id": "network",
  "context": "chroot",
  "description": "Install managed networking and firewall",
  "title": "Install managed networking and firewall",
  "requires": [
    "system-state",
    "service-manager"
  ],
  "packages": [
    "nftables",
    "iptables",
    "netplan.io",
    "wpasupplicant",
    "iw",
    "systemd-resolved"
  ],
  "before_services": "network_setup:apply_selection",
  "systemd_units": [
    "network-exit-uplink-refresh.service",
    "network-exit-uplink-refresh.timer"
  ],
  "private": {
    "network-runtime": {
      "module": "network_runtime",
      "root": true
    }
  },
  "verify": [
    {
      "command": [
        "nft",
        "--version"
      ]
    }
  ],
  "service": {
    "name": "network",
    "label": "Network / Wi-Fi / firewall",
    "units": [
      "network-exit-network.service"
    ],
    "mandatory": true,
    "kind": "system",
    "view": "network_view:screen"
  }
}
