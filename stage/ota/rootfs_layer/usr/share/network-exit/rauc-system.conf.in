[system]
compatible=network-exit-orangepizero3-v2
bootloader=custom
bundle-formats=plain
data-directory=/var/lib/network-exit/rauc

[keyring]
path=/usr/share/network-exit/ota-ca.pem

[handlers]
bootloader-custom-backend=/usr/lib/network-exit/boot-backend

[slot.rootfs.0]
device=/dev/disk/by-partuuid/@DISK_ID@-01
type=ext4
bootname=A

[slot.rootfs.1]
device=/dev/disk/by-partuuid/@DISK_ID@-02
type=ext4
bootname=B
