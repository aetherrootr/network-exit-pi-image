[Unit]
Description=Update optional dynamic DNS record
Wants=network-online.target
Requires=network-exit-state.service network-exit-network.service
After=network-exit-state.service network-exit-network.service network-online.target
ConditionPathExists=/etc/network-exit/ddns.json

[Service]
Type=oneshot
ExecStart=/usr/lib/network-exit/ddns-runtime
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/network-exit
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
